# Scenara 环境变量配置示例
# 将本文件复制为项目根目录下的 `.env` 后再按实际环境修改。
# 应用直接读取进程环境变量；本地启动时需由启动器、容器编排工具或命令行参数显式加载 `.env`。
# 布尔值可使用 1、true、yes、on 表示启用，其他值均按未启用处理，建议统一使用 true 或 false。
# 包含密码、令牌和加密密钥的 `.env` 已被 Git 忽略，禁止提交真实敏感信息。

# 一、运行模式与存储后端

# 运行配置档。development 表示开发环境；prod 或 production 表示生产环境并启用严格配置校验。
SCENARA_PROFILE=development

# 状态数据后端。memory 仅保存在当前进程内，适合开发和测试；生产环境必须使用 postgres。
SCENARA_STATE_BACKEND=memory

# 对象存储后端。local 将文件保存到 SCENARA_DATA_DIR；生产环境必须使用 s3。
SCENARA_OBJECT_BACKEND=local

# 任务队列后端。inline 在请求进程内同步执行，适合开发；生产环境必须使用 redis。
SCENARA_QUEUE_BACKEND=inline

# 本地运行数据目录，用于保存上传文件、预览图和其他运行产物。相对路径以项目启动目录为基准。
SCENARA_DATA_DIR=runtime-state

# 二、身份认证与默认上下文

# 是否强制所有受保护接口进行身份认证。生产环境必须设置为 true。
SCENARA_AUTH_REQUIRED=false

# 平台根令牌，拥有全局管理权限。生产环境必须使用足够长的随机值，禁止与用户密码复用。
SCENARA_API_TOKEN=

# 未显式指定租户时使用的默认租户标识。建议仅使用小写字母、数字和短横线。
SCENARA_DEFAULT_TENANT_ID=default

# 未显式指定项目时使用的默认项目标识。该项目应属于上方配置的默认租户。
SCENARA_DEFAULT_PROJECT_ID=default

# 首次启动时创建的管理员用户名。用户名和密码必须同时填写；留空则不自动创建管理员。
SCENARA_BOOTSTRAP_ADMIN_USERNAME=

# 首次启动管理员密码，长度不得少于 12 个字符。生产环境应使用随机生成的高强度密码。
SCENARA_BOOTSTRAP_ADMIN_PASSWORD=

# 三、上传、采样与结果分片限制

# 单张图片允许的最大字节数。默认 26214400 字节，即 25 MiB；最小值为 1。
SCENARA_MAX_IMAGE_BYTES=26214400

# 单个媒体文件允许的最大字节数。默认 536870912 字节，即 512 MiB；最小值为 1。
SCENARA_MAX_MEDIA_BYTES=536870912

# 单次媒体解析允许生成的最大处理单元数，范围为 1 至 10000。
SCENARA_MAX_MEDIA_UNITS=256

# 媒体采样间隔，单位为毫秒，范围为 1 至 3600000。默认每 1000 毫秒采样一次。
SCENARA_MEDIA_SAMPLE_INTERVAL_MS=1000

# 每个结构化结果分片包含的最大处理单元数，范围为 1 至 10000。
SCENARA_RESULT_SHARD_UNITS=100

# 等待图片处理完成的最长时间，单位为毫秒，范围为 0 至 30000；0 表示不等待。
SCENARA_IMAGE_WAIT_TIMEOUT_MS=10000

# 三之二、跨摄像头长期轨迹

# 是否在解析完成后自动把 tracklet 登记为长期轨迹身份。
SCENARA_TRAJECTORY_ENABLED=true

# 人体 ReID 与人脸的关联判定阈值，余弦相似度，范围为 -1 至 1。
# 人脸证据更可靠，阈值应高于人体。
SCENARA_TRAJECTORY_BODY_THRESHOLD=0.72
SCENARA_TRAJECTORY_FACE_THRESHOLD=0.80

# 登记前的 tracklet 质量门槛与最少帧数，低于门槛的轨迹不会污染身份模板。
SCENARA_TRAJECTORY_MIN_TRACK_QUALITY=0.35
SCENARA_TRAJECTORY_MIN_FRAME_COUNT=2

# 每个长期身份保留的特征模板上限，超出后淘汰质量最低的观测，范围为 1 至 1000。
SCENARA_TRAJECTORY_MAX_TEMPLATES=32

# 未在摄像头拓扑中显式配置时，两个机位之间的默认最短转移秒数。
# 保持 0 表示不施加默认时空约束，按需在摄像头拓扑接口中逐对配置。
SCENARA_TRAJECTORY_DEFAULT_TRANSITION_SECONDS=0

# 四、生产模型、加密与企业策略

# 是否强制只使用生产就绪模型。生产环境必须设置为 true。
SCENARA_PRODUCTION_MODELS_REQUIRED=false

# 私有 OCR 引擎工厂，格式为 模块路径:工厂函数，例如 approved_ocr_adapter:create_engine。
# 开发环境可留空；生产环境必须指向已批准且可导入的 OCR 适配器。
SCENARA_OCR_ENGINE_FACTORY=

# 敏感配置加密密钥，必须是有效的 Fernet 密钥。生产环境必填，密钥轮换前必须做好数据迁移和备份。
SCENARA_SECRET_ENCRYPTION_KEY=

# 是否强制启用企业策略与许可证校验。仅在部署企业版能力时开启。
SCENARA_ENTERPRISE_POLICY_REQUIRED=false

# 企业许可证文件路径。启用企业策略时填写，并确保运行进程对该文件具有只读权限。
SCENARA_ENTERPRISE_LICENSE_PATH=

# 企业许可证验签公钥路径。启用企业策略时填写，并确保公钥与许可证签发方匹配。
SCENARA_ENTERPRISE_PUBLIC_KEY_PATH=

# 五、外部网络访问安全

# 是否允许媒体源指向环回地址、局域网地址或其他私有网络地址。默认关闭以降低服务端请求伪造风险。
SCENARA_ALLOW_PRIVATE_MEDIA_SOURCES=false

# 是否允许 Webhook 目标指向环回地址、局域网地址或其他私有网络地址。默认关闭以降低内网探测风险。
SCENARA_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# 六、数据保留周期

# 原始媒体文件保留天数，范围为 1 至 3650。到期数据可由清理任务删除。
SCENARA_RAW_MEDIA_RETENTION_DAYS=7

# 预览图、裁剪图和处理单元帧保留天数，范围为 1 至 3650。
SCENARA_PREVIEW_RETENTION_DAYS=30

# 结构化分析结果保留天数，范围为 1 至 3650。
SCENARA_STRUCTURED_RESULT_RETENTION_DAYS=180

# 七、运行产物生成

# 是否在解析过程中生成控制台结果面板使用的裁剪图和处理单元帧。
# 这些产物的保留周期由 SCENARA_PREVIEW_RETENTION_DAYS 控制。
SCENARA_RUN_ARTIFACTS_ENABLED=true

# 单次运行最多生成的特征裁剪图数量，范围为 0 至 5000；0 表示不生成裁剪图。
SCENARA_RUN_ARTIFACT_MAX_CROPS=200

# 单次运行最多保存的处理单元帧数量，范围为 0 至 1000；0 表示不保存帧图。
SCENARA_RUN_ARTIFACT_MAX_FRAMES=64

# 特征裁剪图最长边的像素上限，范围为 32 至 2048。超过上限时会按比例缩放。
SCENARA_RUN_ARTIFACT_CROP_MAX_EDGE=256

# 处理单元帧最长边的像素上限，范围为 64 至 8192。超过上限时会按比例缩放。
SCENARA_RUN_ARTIFACT_FRAME_MAX_EDGE=1920

# 八、PostgreSQL、Redis 与 S3 配置
# 以下配置在使用 postgres、redis 或 s3 后端时生效；memory、inline 和 local 开发模式不会使用对应连接信息。

# PostgreSQL 连接地址。生产部署必须替换用户名、密码、主机、端口和数据库名，并优先启用加密连接。
SCENARA_POSTGRES_DSN=postgresql://scenara:replace-with-strong-password@postgres:5432/scenara

# Redis 连接地址，末尾数字表示数据库编号。生产环境如启用认证，应在地址中配置凭据并使用受控网络。
SCENARA_REDIS_URL=redis://redis:6379/0

# S3 兼容对象存储服务地址。使用云厂商原生 S3 时可按适配器要求留空或填写对应端点。
SCENARA_S3_ENDPOINT_URL=http://minio:9000

# S3 区域标识，必须与存储服务或目标存储桶所在区域一致。
SCENARA_S3_REGION=us-east-1

# S3 存储桶名称。运行前应提前创建，并配置最小权限访问策略和生命周期规则。
SCENARA_S3_BUCKET=scenara

# S3 访问密钥标识。生产环境应使用专用服务账户，禁止使用个人账户凭据。
SCENARA_S3_ACCESS_KEY=scenara

# S3 访问密钥。示例值不可用于生产环境，应通过密钥管理服务或部署平台安全注入。
SCENARA_S3_SECRET_KEY=replace-with-strong-password

# PostgreSQL 容器初始化密码，仅供部署编排文件插值使用，应与 SCENARA_POSTGRES_DSN 中的密码保持一致。
SCENARA_POSTGRES_PASSWORD=replace-with-strong-password
