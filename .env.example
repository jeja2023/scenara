# Scenara development defaults
SCENARA_PROFILE=development
SCENARA_STATE_BACKEND=memory
SCENARA_OBJECT_BACKEND=local
SCENARA_QUEUE_BACKEND=inline
SCENARA_DATA_DIR=runtime-state
SCENARA_AUTH_REQUIRED=false
SCENARA_API_TOKEN=
SCENARA_DEFAULT_TENANT_ID=default
SCENARA_DEFAULT_PROJECT_ID=default
SCENARA_MAX_IMAGE_BYTES=26214400
SCENARA_IMAGE_WAIT_TIMEOUT_MS=10000
SCENARA_PRODUCTION_MODELS_REQUIRED=false

# Production Compose values
SCENARA_POSTGRES_DSN=postgresql://scenara:change-me@postgres:5432/scenara
SCENARA_REDIS_URL=redis://redis:6379/0
SCENARA_S3_ENDPOINT_URL=http://minio:9000
SCENARA_S3_REGION=us-east-1
SCENARA_S3_BUCKET=scenara
SCENARA_S3_ACCESS_KEY=scenara
SCENARA_S3_SECRET_KEY=change-me
SCENARA_POSTGRES_PASSWORD=change-me
