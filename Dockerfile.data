FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /opt/scenara-data
COPY requirements/production.lock requirements/production.lock
RUN python -m pip install --require-hashes -r requirements/production.lock
COPY scenara_data scenara_data
COPY migrations/data migrations/data
RUN mkdir -p /var/lib/scenara-data && chown -R 10001:10001 /var/lib/scenara-data
USER 10001:10001
EXPOSE 8010
CMD ["python", "-m", "scenara_data"]
