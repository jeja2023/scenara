# 运行时缓存
__pycache__/
*.py[cod]
*.pyc.*
.pytest_cache/
.pycache_check/
.mypy_cache/
.ruff_cache/

# 测试和运行时临时文件
.test_tmp/
pytest-cache-files-*/
.coverage
htmlcov/
artifacts/
rollout-audit*.jsonl
runtime-state/
*.log

# 本地系统和环境文件
.DS_Store
.env
.env.*
!.env.example
!.env.*.example
.venv
venv/
env/

# 本地凭据和私钥
.aws/
.ssh/
.npmrc
.pypirc
credentials.json
service-account.json
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore


# 模型文件通过挂载或外部渠道提供
models/*
!models/*.governance.yml
!models/*.labels.txt
!models/*.model-card.yml

# Codex 临时文件
.codex-tmp/
.omx/
temp_gov_check_probe.txt

# Node.js build output. The console bundle is deployment-generated; the
# TypeScript SDK dist/ directory is intentionally tracked as a publishable
# package artifact.
node_modules/
package-lock.json
.pnpm-store/
frontend/console-next/
frontend/console-next/dist/
frontend/console-next/test-results/
frontend/console-next/playwright-report/
frontend/console/dist/
frontend/console/test-results/
frontend/console/playwright-report/

# Python package build output
sdk/python/build/
sdk/python/*.egg-info/

# Java build output
sdk/java/target/

# Local scan results and patches
gitleaks-results.json
*.patch
repository-contracts-*.zip
