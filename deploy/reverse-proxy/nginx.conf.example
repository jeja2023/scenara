# Replace domain and certificate paths. Run nginx as a dedicated unprivileged service.
limit_req_zone $binary_remote_addr zone=scenara_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=scenara_conn:10m;

upstream scenara_backend {
    server 127.0.0.1:8000;
    keepalive 64;
}

server {
    listen 443 ssl http2;
    server_name scenara.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/scenara.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scenara.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ScenaraTLS:10m;
    ssl_session_tickets off;

    # Keep this aligned with SCENARA_MAX_MULTIPART_UPLOAD_BYTES.  Larger
    # media uses the authenticated S3 presigned-upload flow.
    client_max_body_size 512m;
    client_body_timeout 300s;
    keepalive_timeout 65s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        limit_req zone=scenara_api burst=40 nodelay;
        limit_conn scenara_conn 50;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://scenara_backend;
    }

    # SSE, long-running parse status and stream control must not be buffered.
    location ~ ^/api/v1/(runs/[^/]+/events|parse/stream) {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://scenara_backend;
    }
}

server {
    listen 80;
    server_name scenara.example.com;
    return 308 https://$host$request_uri;
}
