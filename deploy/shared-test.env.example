# Shared-infrastructure test environment. Do not use for internet-facing production.
# Values must match deploy/shared-infra/.env.example and the Data/Model test env files.
SCENARA_PROFILE=development
SCENARA_PLATFORM_NETWORK=scenara-platform

SCENARA_POSTGRES_PASSWORD=replace-with-core-db-password
SCENARA_REDIS_PASSWORD=replace-with-redis-password
SCENARA_S3_ENDPOINT_URL=http://minio:9000
SCENARA_S3_ACCESS_KEY=scenara-core
SCENARA_S3_SECRET_KEY=replace-with-core-s3-secret
SCENARA_S3_VERIFY_TLS=false
SCENARA_S3_SERVER_SIDE_ENCRYPTION=
SCENARA_MINIO_ROOT_USER=minio-admin
SCENARA_MINIO_ROOT_PASSWORD=replace-with-minio-root-password

SCENARA_DATA_PLATFORM_URL=http://data-api:8081
SCENARA_DATA_PLATFORM_SERVICE_TOKEN=replace-with-core-to-data-token
SCENARA_DATA_EVENT_SERVICE_TOKEN=replace-with-data-to-core-event-token
SCENARA_DATA_CONTEXT_SIGNING_KEY=replace-with-shared-data-context-key
SCENARA_ALLOW_INSECURE_INTERNAL_ENDPOINTS=true

SCENARA_API_TOKEN=replace-with-core-api-token
SCENARA_SECRET_ENCRYPTION_KEY=replace-with-fernet-key
SCENARA_ALLOWED_HOSTS=127.0.0.1,localhost
SCENARA_BOOTSTRAP_ADMIN_USERNAME=admin
SCENARA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
SCENARA_PRODUCTION_MODELS_REQUIRED=false
SCENARA_OCR_ENGINE_FACTORY=scenara.domains.ocr:create_engine
SCENARA_BEHAVIOR_ENGINE_FACTORY=scenara.domains.behavior:create_engine
SCENARA_FASHION_ENGINE_FACTORY=scenara.domains.fashion:create_engine

# Shared test deployment uses the image built from this checkout.
SCENARA_IMAGE_REFERENCE=
SCENARA_IMAGE_TAG=shared-test
