# Shared test/staging infrastructure. Use URL-safe random values.
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_PLATFORM_CERTS_DIR=/secure/scenara-certs
SCENARA_PLATFORM_CA_FILE=/run/tls/ca.crt

SCENARA_INFRA_POSTGRES_ADMIN_USER=scenara_admin
SCENARA_INFRA_POSTGRES_ADMIN_PASSWORD=replace-with-admin-password
SCENARA_CORE_DB_PASSWORD=replace-with-core-db-password
SCENARA_DATA_DB_PASSWORD=replace-with-data-db-password
SCENARA_MODEL_DB_PASSWORD=replace-with-model-db-password

SCENARA_INFRA_REDIS_PASSWORD=replace-with-redis-password

SCENARA_INFRA_MINIO_ROOT_USER=minio-admin
SCENARA_INFRA_MINIO_ROOT_PASSWORD=replace-with-minio-root-password
SCENARA_CORE_S3_ACCESS_KEY=scenara-core
SCENARA_CORE_S3_SECRET_KEY=replace-with-core-s3-secret
SCENARA_DATA_S3_ACCESS_KEY=scenara-data
SCENARA_DATA_S3_SECRET_KEY=replace-with-data-s3-secret
SCENARA_MODEL_S3_ACCESS_KEY=scenara-model
SCENARA_MODEL_S3_SECRET_KEY=replace-with-model-s3-secret

# Loopback-only administration ports.
SCENARA_INFRA_POSTGRES_PORT=55432
SCENARA_INFRA_REDIS_PORT=56379
SCENARA_INFRA_MINIO_PORT=59000
SCENARA_INFRA_MINIO_CONSOLE_PORT=59001
