# ==============================================================================
# Scenara 生产环境配置模板 (.env.production.example)
# 使用说明:
# 1. 部署前复制本文件为 deploy/.env.production: cp deploy/.env.production.example deploy/.env.production
# 2. 替换所有 replace-with-* 占位符为真实的高强度凭据与有效密钥
# 3. 生产环境密钥生成命令:
#    Fernet 密钥: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    随机 Token:  openssl rand -hex 32
# ==============================================================================

# 1. 数据库安全配置
# PostgreSQL 数据库超级用户/业务用户密码（强随机密码）
SCENARA_POSTGRES_PASSWORD=replace-with-strong-password

# 2. 数据中台集成
# 生产模式下数据中台服务基地址（请按实际部署网络环境修改）
SCENARA_DATA_PLATFORM_URL=https://data.internal.example
# Scenara 向数据中台通信时携带的服务 Token
SCENARA_DATA_PLATFORM_SERVICE_TOKEN=replace-with-core-to-data-service-token
# 数据中台向 Scenara 回传事件时携带的校验 Token
SCENARA_DATA_EVENT_SERVICE_TOKEN=replace-with-data-to-core-service-token

# 3. 对象存储 (MinIO / S3)
# S3 Access Key
SCENARA_S3_ACCESS_KEY=scenara
# MinIO 根用户及 S3 访问 Secret Key（强随机密码）
SCENARA_S3_SECRET_KEY=replace-with-strong-password
# S3 TLS 证书校验
SCENARA_S3_VERIFY_TLS=true
# 启用对象生命周期自动清理
SCENARA_S3_LIFECYCLE_ENABLED=true
# 是否启用客户端直传/预签名 URL
SCENARA_S3_PRESIGNED_URLS_ENABLED=false
# 对外公开 S3 访问地址（例如 https://objects.example.com 或 http://<公网IP>:9000，按需填写）
SCENARA_S3_PUBLIC_ENDPOINT_URL=
# S3 寻址风格 (auto / path / virtual)
SCENARA_S3_ADDRESSING_STYLE=path

# 4. 系统鉴权与机密加密
# 生产 API 与控制台鉴权 Bootstrap Token
SCENARA_API_TOKEN=replace-with-long-random-bootstrap-token
# Fernet 对称加密密钥（用于视频流凭据/Webhook密钥落盘加密，需使用 Fernet.generate_key() 生成）
SCENARA_SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key

# 5. Web 控制台初始管理员（可选，用于 /console/ 页面首次登录，密码必须 >= 12 位）
SCENARA_BOOTSTRAP_ADMIN_USERNAME=admin
SCENARA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password-12chars

# 6. 企业策略扩展配置
# 默认为个人/社区部署模式(false)；若使用 compose.enterprise.yml 且已购买企业授权请设为 true
SCENARA_ENTERPRISE_POLICY_REQUIRED=false
# SCENARA_ENTERPRISE_LICENSE_FILE=/secure/scenara-enterprise-license.json
# SCENARA_ENTERPRISE_PUBLIC_KEY_FILE=/secure/scenara-enterprise-public-key.pem

# 7. 算法模型与适配器
# 生产 OCR 引擎适配器工厂函数（需在 models/ 目录下提供对应实现）
SCENARA_OCR_ENGINE_FACTORY=approved_ocr_adapter:create_engine

# 8. 网络访问安全与 SSRF 防护
# 是否允许私网 IP 媒体源（若需要在内网拉取 RTSP/RTMP 摄像头流，请设置为 true）
SCENARA_ALLOW_PRIVATE_MEDIA_SOURCES=false
# 是否允许向私网 IP 发送 Webhook 回调
SCENARA_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# 9. 数据生命周期与保留周期（天）及特征裁剪图配额
SCENARA_RAW_MEDIA_RETENTION_DAYS=7
SCENARA_PREVIEW_RETENTION_DAYS=30
SCENARA_STRUCTURED_RESULT_RETENTION_DAYS=180
# 单次运行最大保存特征裁剪图数量（范围 0–5000，默认 200；调大可覆盖更多目标，调至 2000-5000 可消除大视频告警）
SCENARA_RUN_ARTIFACT_MAX_CROPS=2000

# 10. 部署镜像版本
SCENARA_IMAGE_TAG=0.3.0-dev.24

# 11. GPU 调度配置（可选）
# 默认留空，API/Worker 会自动检测并使用所有可见 GPU
# 若需指定特定 GPU，可解除注释并设置（例如 GPU_DEVICE_IDS=0 或 GPU_DEVICE_IDS=0,1）
# GPU_DEVICE_IDS=0
