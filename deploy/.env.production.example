SCENARA_POSTGRES_PASSWORD=replace-with-strong-password
SCENARA_S3_ACCESS_KEY=scenara
SCENARA_S3_SECRET_KEY=replace-with-strong-password
SCENARA_S3_VERIFY_TLS=true
SCENARA_S3_LIFECYCLE_ENABLED=true
SCENARA_S3_PRESIGNED_URLS_ENABLED=false
# Set when enabling direct browser/SDK transfers, for example https://objects.example.com.
SCENARA_S3_PUBLIC_ENDPOINT_URL=
SCENARA_S3_ADDRESSING_STYLE=path
SCENARA_API_TOKEN=replace-with-long-random-bootstrap-token
SCENARA_SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Optional legacy enterprise policy compatibility; leave unset for self-hosted deployments.
# SCENARA_ENTERPRISE_LICENSE_PATH=
# SCENARA_ENTERPRISE_PUBLIC_KEY_PATH=
SCENARA_OCR_ENGINE_FACTORY=approved_ocr_adapter:create_engine
SCENARA_ALLOW_PRIVATE_MEDIA_SOURCES=false
SCENARA_ALLOW_PRIVATE_WEBHOOK_TARGETS=false
SCENARA_RAW_MEDIA_RETENTION_DAYS=7
SCENARA_PREVIEW_RETENTION_DAYS=30
SCENARA_STRUCTURED_RESULT_RETENTION_DAYS=180
SCENARA_IMAGE_TAG=0.3.0-dev.21
