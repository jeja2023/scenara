# Scenara 生产配置候选模板。不得直接部署本文件。
# 1. 推荐生成独立随机密钥：
#    python scripts/generate_production_env.py --output /secure/scenara.env
# 2. 填写主机名、反向代理、镜像摘要、Data 地址和三个已批准模型工厂。
# 3. 验证：python scripts/validate_production_config.py --env-file /secure/scenara.env
# 4. Linux 上环境文件权限必须为 0600；生产服务应通过 TLS 反向代理访问。

# 发布身份：生产环境必须引用内容摘要，不得使用 latest 或可变开发标签。
SCENARA_IMAGE_TAG=0.3.0-dev.38
SCENARA_IMAGE_REFERENCE=scenara-api@sha256:replace-with-64-lowercase-hex-image-digest

# API 只绑定回环地址，由反向代理承担 TLS、连接限制和请求体上限。
SCENARA_BIND_ADDRESS=127.0.0.1
SCENARA_HTTP_PORT=8000
SCENARA_ALLOW_DIRECT_HTTP=false
SCENARA_ALLOWED_HOSTS=scenara.example.com
# 仅填写实际反向代理地址/CIDR，禁止使用 *。
SCENARA_FORWARDED_ALLOW_IPS=replace-with-proxy-address-or-cidr
SCENARA_HSTS_ENABLED=true
SCENARA_HSTS_MAX_AGE_SECONDS=31536000

# PostgreSQL 与 Redis。密码应为 URL-safe 随机值，避免 DSN 转义歧义。
SCENARA_POSTGRES_PASSWORD=replace-with-postgres-password
SCENARA_REDIS_PASSWORD=replace-with-redis-password

# 独立 Scenara Data 服务；外部或跨节点连接必须使用 HTTPS。
SCENARA_DATA_PLATFORM_URL=https://data.internal.example
SCENARA_DATA_PLATFORM_SERVICE_TOKEN=replace-with-core-to-data-service-token
SCENARA_DATA_EVENT_SERVICE_TOKEN=replace-with-data-to-core-service-token
SCENARA_DATA_PLATFORM_TIMEOUT_SECONDS=10
SCENARA_DATA_PLATFORM_MAX_RETRIES=2
# 仅当 Data 位于同一隔离容器网络且使用明文 HTTP 时才显式开启。
SCENARA_ALLOW_INSECURE_INTERNAL_ENDPOINTS=false

# Compose 内置 MinIO 根管理员与应用 S3 凭据必须分离。
SCENARA_MINIO_ROOT_USER=replace-with-minio-root-user
SCENARA_MINIO_ROOT_PASSWORD=replace-with-minio-root-password
SCENARA_S3_ACCESS_KEY=replace-with-s3-access-key
SCENARA_S3_SECRET_KEY=replace-with-s3-secret-key
SCENARA_S3_SESSION_TOKEN=
SCENARA_S3_PUBLIC_ENDPOINT_URL=
SCENARA_S3_VERIFY_TLS=true
SCENARA_S3_CA_BUNDLE=
SCENARA_S3_SERVER_SIDE_ENCRYPTION=AES256
SCENARA_S3_KMS_KEY_ID=
SCENARA_S3_LIFECYCLE_ENABLED=true
SCENARA_S3_PRESIGNED_URLS_ENABLED=false
SCENARA_S3_PRESIGN_EXPIRY_SECONDS=900
SCENARA_S3_ADDRESSING_STYLE=path
SCENARA_S3_MULTIPART_THRESHOLD_BYTES=67108864
SCENARA_S3_MULTIPART_CHUNK_BYTES=16777216

# 可选 Qdrant；留空时使用 PostgreSQL/pgvector。
SCENARA_QDRANT_URL=
SCENARA_QDRANT_API_KEY=
SCENARA_QDRANT_TIMEOUT_SECONDS=10
SCENARA_QDRANT_COLLECTION_PREFIX=scenara_features

# API 启动凭据、密文密钥与首个管理员。初始化并创建正式服务账号后轮换 API Token。
SCENARA_AUTH_REQUIRED=true
SCENARA_API_TOKEN=replace-with-long-random-bootstrap-token
SCENARA_SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
SCENARA_BOOTSTRAP_ADMIN_USERNAME=scenara-admin
SCENARA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password-16chars

# 生产模型必须由私有、已批准适配器提供。禁止填写 scenara.domains.* 参考实现。
SCENARA_PRODUCTION_MODELS_REQUIRED=true
SCENARA_OCR_ENGINE_FACTORY=approved_models.ocr:create_engine
SCENARA_BEHAVIOR_ENGINE_FACTORY=approved_models.behavior:create_engine
SCENARA_FASHION_ENGINE_FACTORY=approved_models.fashion:create_engine

# 对象和结果容量边界。
SCENARA_MAX_IMAGE_BYTES=26214400
SCENARA_MAX_MEDIA_BYTES=21474836480
SCENARA_MEDIA_SAMPLE_INTERVAL_MS=1000
SCENARA_STREAM_SEGMENT_DURATION_MS=300000
SCENARA_SURVEILLANCE_ALERT_SNAPSHOT_RETENTION_DAYS=30
SCENARA_RESULT_SHARD_UNITS=100
SCENARA_IMAGE_WAIT_TIMEOUT_MS=10000
SCENARA_RUN_ARTIFACTS_ENABLED=true
SCENARA_RUN_ARTIFACT_CROP_MAX_EDGE=256
SCENARA_RUN_ARTIFACT_FRAME_MAX_EDGE=1920

# 数据保留期必须满足 raw <= preview <= structured result。
SCENARA_RAW_MEDIA_RETENTION_DAYS=7
SCENARA_PREVIEW_RETENTION_DAYS=30
SCENARA_STRUCTURED_RESULT_RETENTION_DAYS=180

# 默认拒绝私网媒体和私网 Webhook。需要内网摄像头时，应先完成网络隔离再开启。
SCENARA_ALLOW_PRIVATE_MEDIA_SOURCES=false
SCENARA_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# 轨迹与检索阈值须由固定评估集确定。
SCENARA_TRAJECTORY_ENABLED=true
SCENARA_TRAJECTORY_BODY_THRESHOLD=0.72
SCENARA_TRAJECTORY_FACE_THRESHOLD=0.80
SCENARA_TRAJECTORY_MIN_TRACK_QUALITY=0.35
SCENARA_TRAJECTORY_MIN_FRAME_COUNT=2
SCENARA_TRAJECTORY_MAX_TEMPLATES=32
SCENARA_TRAJECTORY_DEFAULT_TRANSITION_SECONDS=0

# GPU 可见性。多 Worker 生产部署建议显式分配，避免两个进程争抢同一显存。
GPU_DEVICE_IDS=0

# 企业策略为可选叠加层；启用时同时传入签名许可证和公钥文件。
SCENARA_ENTERPRISE_POLICY_REQUIRED=false
# SCENARA_ENTERPRISE_LICENSE_FILE=/secure/scenara-enterprise-license.json
# SCENARA_ENTERPRISE_PUBLIC_KEY_FILE=/secure/scenara-enterprise-public-key.pem
